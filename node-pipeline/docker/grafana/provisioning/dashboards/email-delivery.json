{
  "uid": "email-delivery",
  "title": "Email Delivery",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput (jobs/sec)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(email_jobs_submitted_total[1m])",
          "legendFormat": "submitted"
        },
        {
          "expr": "sum(rate(email_jobs_delivered_total[1m]))",
          "legendFormat": "delivered"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Delivery latency p50/p95/p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(email_delivery_duration_seconds_bucket[2m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(email_delivery_duration_seconds_bucket[2m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(email_delivery_duration_seconds_bucket[2m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "email_queue_depth", "legendFormat": "{{queue}}" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Retries / dead letters (per sec)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(email_jobs_retried_total[2m]))",
          "legendFormat": "retries"
        },
        {
          "expr": "sum(rate(email_jobs_dead_lettered_total[2m]))",
          "legendFormat": "dead letters"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Duplicate redeliveries prevented",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "email_duplicate_redeliveries_skipped_total",
          "legendFormat": "skipped"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Provider send duration p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(email_send_duration_seconds_bucket[2m])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
